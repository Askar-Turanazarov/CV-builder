{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/app.en.html"
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "uz"
        }
      ],
      "destination": "/app.uz.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.ru.html"
    }
  ]
}
