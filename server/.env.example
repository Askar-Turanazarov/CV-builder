# Порт Express-сервера (не PORT — это имя зарезервировано некоторыми
# хостинг-платформами и средами предпросмотра для основного веб-процесса)
SERVER_PORT=3001

# Origin клиента, разрешённый для CORS
CLIENT_ORIGIN=http://localhost:5173

# Ключ Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Ключ Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Приоритетный список кандидатов provider:model через запятую.
# Оркестратор перебирает их по порядку, молча пропуская временно недоступных
# и тех, у кого нет ключа (Claude без ANTHROPIC_API_KEY пропускается).
# Таймаут одной попытки и общий дедлайн запроса (мс), по умолчанию 20000 / 50000:
# AI_ATTEMPT_TIMEOUT_MS=20000
# AI_REQUEST_DEADLINE_MS=50000
AI_PROVIDER_PRIORITY=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,gemini:gemini-3.5-flash,anthropic:claude-haiku-5-5,anthropic:claude-sonnet-5-5
